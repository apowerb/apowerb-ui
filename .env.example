# .env.example — Frontend (Next.js)
# Copy this file to .env.local and fill in the values

# ── Backend API ───────────────────────────────────
# API_URL is server-side only: Next.js Route Handlers use it to proxy SSE
# streams. NEXT_PUBLIC_API_URL is the one the browser calls.
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Auth mode ─────────────────────────────────────
# Set to "true" to use mock auth (no backend needed)
# NEXT_PUBLIC_USE_MOCK_AUTH=true

# ── OAuth — GitHub ────────────────────────────────
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id

# ── OAuth — Google ────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# ── OAuth — Microsoft ─────────────────────────────
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=your_microsoft_client_id
NEXT_PUBLIC_MICROSOFT_TENANT_ID=common

# ── OAuth — LinkedIn ────────────────────────────
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=your_linkedin_client_id
